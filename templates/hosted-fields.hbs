<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <!-- PayMe SDK -->
    <script src="{{paymeSdkUrl}}"></script>

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            margin: 0;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .container {
            max-width: 820px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
        }
        h1 { color: #333; margin: 0 0 10px; }
        .sale-info {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 24px;
        }
        .info-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #e8e8e8;
            font-size: 13px;
        }
        .info-item:last-child { border-bottom: none; }
        .info-label { font-weight: 600; color: #666; }
        .info-value { color: #333; font-family: 'Courier New', monospace; word-break: break-all; text-align: right; }

        .field-block { margin-bottom: 18px; }
        .field-block label {
            display: block;
            font-weight: 600;
            color: #555;
            font-size: 13px;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .hosted-field {
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            height: 46px;
            padding: 0 12px;
            background: white;
            display: flex;
            align-items: center;
            transition: border-color 0.2s ease;
        }
        .hosted-field.valid { border-color: #28a745; }
        .hosted-field.invalid { border-color: #dc3545; }
        .field-msg { color: #dc3545; font-size: 12px; margin: 6px 0 0; min-height: 14px; }
        .brand-tag {
            font-weight: 500;
            color: #667eea;
            text-transform: none;
            letter-spacing: 0;
        }

        .actions { display: flex; gap: 12px; margin: 24px 0 8px; }
        button {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        #tokenize-btn { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; }
        #tokenize-btn:disabled { background: #ccc; color: #888; cursor: not-allowed; }
        #teardown-btn { background: #6c757d; color: #fff; flex: 0 0 auto; padding: 14px 20px; }

        .hidden { display: none !important; }
        .success-message { padding: 16px; background: #d4edda; border: 1px solid #28a745; border-radius: 8px; color: #155724; margin-top: 20px; }
        .error-message { padding: 16px; background: #f8d7da; border: 1px solid #dc3545; border-radius: 8px; color: #721c24; margin-top: 20px; }
        .panel-title { font-weight: 700; margin-bottom: 8px; }
        pre { margin: 0; font-size: 12px; white-space: pre-wrap; word-wrap: break-word; }

        .console-log {
            background: #1e1e1e;
            color: #d4d4d4;
            border-radius: 8px;
            padding: 16px;
            margin-top: 24px;
            max-height: 280px;
            overflow-y: auto;
        }
        .console-log .panel-title { color: #fff; }
        .back-button {
            display: inline-block;
            margin-top: 24px;
            padding: 12px 24px;
            background: #6c757d;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>{{title}}</h1>

        <div class="sale-info">
            <div class="info-item"><span class="info-label">Auth token (MPL)</span><span class="info-value">{{sellerPaymeId}}</span></div>
            <div class="info-item"><span class="info-label">Test mode</span><span class="info-value">{{#if testMode}}true{{else}}false{{/if}}</span></div>
            <div class="info-item"><span class="info-label">API URL</span><span class="info-value">{{#if apiUrl}}{{apiUrl}}{{else}}default (live){{/if}}</span></div>
            <div class="info-item"><span class="info-label">Language</span><span class="info-value">{{language}}</span></div>
            <div class="info-item"><span class="info-label">SDK</span><span class="info-value">{{paymeSdkUrl}}</span></div>
        </div>

        <form id="hf-form" onsubmit="return false;">
            <div id="fields-root"></div>
            <p id="no-fields-note" class="error-message hidden">No hosted fields were selected — tokenize() will run with payer values only and is expected to fail validation.</p>

            <div class="actions">
                <button type="submit" id="tokenize-btn" disabled>Tokenize</button>
                <button type="button" id="teardown-btn">Teardown</button>
            </div>
        </form>

        <div id="result-panel" class="success-message hidden">
            <div class="panel-title">Tokenization result</div>
            <pre id="result-output"></pre>
        </div>
        <div id="error-panel" class="error-message hidden">
            <div class="panel-title">Tokenization error</div>
            <pre id="error-output"></pre>
        </div>

        <div class="console-log">
            <div class="panel-title">Event log</div>
            <pre id="console-output"></pre>
        </div>

        <a href="/hosted-fields-form" class="back-button">Back to config</a>
    </div>

    <script>
      window.__CONFIG__ = {{{configJson}}};
    </script>
    <script>
      (function (global) {
        'use strict';

        var CONFIG = global.__CONFIG__ || {};
        var consoleOutput = document.getElementById('console-output');
        var fieldsRoot = document.getElementById('fields-root');
        var tokenizeBtn = document.getElementById('tokenize-btn');
        var teardownBtn = document.getElementById('teardown-btn');
        var form = document.getElementById('hf-form');
        var resultPanel = document.getElementById('result-panel');
        var resultOutput = document.getElementById('result-output');
        var errorPanel = document.getElementById('error-panel');
        var errorOutput = document.getElementById('error-output');

        function log(message) {
          var ts = new Date().toLocaleTimeString();
          consoleOutput.textContent += '[' + ts + '] ' + message + '\n';
          consoleOutput.parentElement.scrollTop = consoleOutput.parentElement.scrollHeight;
          // eslint-disable-next-line no-console
          console.log('[hosted-fields]', message);
        }

        function showResult(data) {
          errorPanel.classList.add('hidden');
          resultOutput.textContent = JSON.stringify(data, null, 2);
          resultPanel.classList.remove('hidden');
        }

        function showError(err) {
          resultPanel.classList.add('hidden');
          var payload = err;
          if (err instanceof Error) {
            payload = { message: err.message, stack: err.stack };
          }
          errorOutput.textContent = JSON.stringify(payload, null, 2);
          errorPanel.classList.remove('hidden');
          // Surface field-keyed validation errors inline as well.
          if (payload && payload.errors) {
            Object.keys(payload.errors).forEach(function (key) {
              setFieldMessage(key, payload.errors[key], false);
            });
          }
        }

        function buildFieldBlock(field) {
          var block = document.createElement('div');
          block.className = 'field-block';

          var label = document.createElement('label');
          label.textContent = field.label;
          if (field.key === 'cardNumber') {
            var brand = document.createElement('span');
            brand.className = 'brand-tag';
            brand.id = 'brand-tag';
            label.appendChild(document.createTextNode(' '));
            label.appendChild(brand);
          }

          var container = document.createElement('div');
          container.className = 'hosted-field';
          container.id = field.containerId;

          var msg = document.createElement('p');
          msg.className = 'field-msg';
          msg.id = 'msg-' + field.key;

          block.appendChild(label);
          block.appendChild(container);
          block.appendChild(msg);
          fieldsRoot.appendChild(block);
        }

        function setFieldMessage(fieldKey, message, isValid) {
          var msgEl = document.getElementById('msg-' + fieldKey);
          var container = document.getElementById(containerIdFor(fieldKey));
          if (msgEl) { msgEl.textContent = message || ''; }
          if (container) {
            container.classList.remove('valid', 'invalid');
            if (isValid === true) { container.classList.add('valid'); }
            else if (isValid === false) { container.classList.add('invalid'); }
          }
        }

        var containerIndex = {};
        function containerIdFor(fieldKey) { return containerIndex[fieldKey]; }

        function onFieldEvent(field, ev) {
          // ev: { isValid, message, isEmpty, field, type }
          if (ev.isValid) {
            setFieldMessage(field.key, '', ev.isEmpty ? null : true);
          } else {
            setFieldMessage(field.key, ev.message || '', ev.isEmpty ? null : false);
          }
        }

        if (!global.PayMe) {
          log('ERROR: PayMe SDK failed to load from ' + '{{paymeSdkUrl}}');
          showError(new Error('PayMe SDK not loaded'));
          return;
        }
        log('PayMe SDK version: ' + (global.PayMe.version || 'unknown'));

        var fields = CONFIG.fields || [];
        if (!fields.length) {
          document.getElementById('no-fields-note').classList.remove('hidden');
        }
        fields.forEach(function (f) {
          containerIndex[f.key] = f.containerId;
          buildFieldBlock(f);
        });

        var createOpts = { testMode: CONFIG.testMode, language: CONFIG.language };
        if (CONFIG.apiUrl) { createOpts.apiUrl = CONFIG.apiUrl; }
        log('PayMe.create(token, ' + JSON.stringify(createOpts) + ')');

        global.PayMe.create(CONFIG.token, createOpts).then(function (instance) {
          log('Instance created. Mounting hosted fields...');
          var hostedFields = instance.hostedFields();
          var ready = [];

          fields.forEach(function (f) {
            var settings = {
              placeholder: f.label,
              messages: { invalid: 'Invalid ' + f.label, required: f.label + ' is required' }
            };
            var field = hostedFields.create(f.key, settings);

            field.on('validity-changed', function (ev) { onFieldEvent(f, ev); });
            field.on('keyup', function (ev) { onFieldEvent(f, ev); });
            if (f.key === 'cardNumber') {
              field.on('card-type-changed', function (ev) {
                var tag = document.getElementById('brand-tag');
                if (tag) { tag.textContent = ev.cardType ? '(' + ev.cardType + ')' : ''; }
                log('card-type-changed: ' + ev.cardType);
              });
            }

            ready.push(
              field.mount('#' + f.containerId).then(function () { log('Mounted: ' + f.key); })
            );
          });

          Promise.all(ready).then(function () {
            tokenizeBtn.disabled = false;
            log(fields.length ? 'All fields mounted — ready to tokenize.' : 'No fields to mount — ready to tokenize.');
          });

          form.addEventListener('submit', function () {
            resultPanel.classList.add('hidden');
            errorPanel.classList.add('hidden');
            tokenizeBtn.disabled = true;

            var opts = {};
            Object.keys(CONFIG.payerValues || {}).forEach(function (k) { opts[k] = CONFIG.payerValues[k]; });
            opts.total = CONFIG.total;

            log('tokenize(' + JSON.stringify(opts) + ')');
            instance.tokenize(opts)
              .then(function (data) {
                log('TOKENIZE SUCCESS');
                showResult(data);
                tokenizeBtn.disabled = false;
              })
              .catch(function (err) {
                log('TOKENIZE ERROR');
                showError(err);
                tokenizeBtn.disabled = false;
              });
          });

          teardownBtn.addEventListener('click', function () {
            try {
              instance.teardown();
              log('Integration torn down.');
              tokenizeBtn.disabled = true;
              fieldsRoot.innerHTML = '';
            } catch (e) {
              log('Teardown error: ' + e.message);
            }
          });
        }).catch(function (err) {
          log('PayMe.create failed: ' + err.message);
          showError(err);
        });
      })(window);
    </script>
</body>
</html>
